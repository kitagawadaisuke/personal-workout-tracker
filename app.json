{
  "expo": {
    "name": "SlowRep",
    "slug": "workout-tracker",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101815"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.d.workouttracker",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "履歴で月間の合計歩数・1日平均・日別の推移を表示するため、ヘルスケアの歩数を読み取ります。歩数は外部へ送信しません。",
        "NSHealthUpdateUsageDescription": "SlowRepはヘルスケアのデータを書き換えません。歩数の読み取りだけを使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101815"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "workout-tracker",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62111c91-dcf0-4f36-b857-b9a0698b7b14"
      }
    }
  }
}
